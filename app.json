{
  "expo": {
    "name": "WorldJam",
    "slug": "worldjam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/branding/icon.png",
    "android": {
      "package": "com.prxfr.worldjam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "WorldJam uses the camera to place sound objects in your room."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "WorldJam uses the camera to find objects you can play.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "WorldJam records the real sound of the objects you tap."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "useLegacyPackaging": true,
            "extraProguardRules": "",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "./plugins/withKotlinPin",
      "./plugins/withBuildTuning",
      "./plugins/withLlamaCpuOnly",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
