<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Android 12+ only lets an app dlopen() these vendor libraries when they are
      declared. QNN's HTP stub needs libcdsprpc.so to reach the DSP; without it
      session creation fails with QNN_DEVICE_ERROR_INVALID_CONFIG. Optional, so
      devices without them still install and fall back to LiteRT.
    -->
    <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    <uses-native-library android:name="libOpenCL.so" android:required="false" />
  </application>
</manifest>
