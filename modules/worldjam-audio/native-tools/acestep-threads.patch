diff --git a/src/backend.h b/src/backend.h
index 394cbcb..72b588c 100644
--- a/src/backend.h
+++ b/src/backend.h
@@ -26,6 +26,13 @@ static int         g_backend_refs  = 0;
 // Used for GGML CPU thread count: GEMM shares SIMD units across hyperthreads,
 // so one thread per physical core is optimal.
 static int backend_cpu_n_threads(void) {
+    // WorldJam: phones have no SMT, so let the app pick (ACE_THREADS).
+    if (const char * e = std::getenv("ACE_THREADS")) {
+        const int v = std::atoi(e);
+        if (v > 0) {
+            return v;
+        }
+    }
     int n = (int) std::thread::hardware_concurrency() / 2;
     return n > 0 ? n : 1;
 }
